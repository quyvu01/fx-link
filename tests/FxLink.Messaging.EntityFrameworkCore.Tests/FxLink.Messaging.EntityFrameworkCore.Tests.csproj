             (GHSA-2m69-gcr7-jv3q); pinned up directly. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[2.1.13, )"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\FxLink.EntityFramework\FxLink.EntityFramework.csproj"/>
    </ItemGroup>

</Project>
