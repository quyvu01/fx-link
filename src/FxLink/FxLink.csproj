<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <Version>2.3.0</Version>
        <Authors>Quy Vu</Authors>
        <PackageId>FxLink</PackageId>
        <Description>The distributed messaging .NET</Description>
        <PackageTags>FxLink;distributed;open-source</PackageTags>
        <RepositoryUrl>https://github.com/quyvu01/fx-link</RepositoryUrl>
        <PackageIcon>FxLink.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[8.0.0, )"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="[8.0.0, )"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="[8.0.0, )"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FxLink.RabbitMq"/>
        <InternalsVisibleTo Include="FxLink.StateMachine"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\FxLink.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>FxLink.png</Link>
        </None>
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\"/>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>
